# ONEKA AI - Satellite Processing Configuration
# Copy this file to .env and fill in your credentials

# ============================================================================
# Copernicus Data Space Ecosystem
# ============================================================================

# Register at: https://dataspace.copernicus.eu/
COPERNICUS_USERNAME=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

# OAuth2 credentials (optional, for API access)
COPERNICUS_CLIENT_ID=your_client_id_here
COPERNICUS_CLIENT_SECRET=your_client_secret_here

# ============================================================================
# Data Storage Paths
# ============================================================================

# Local data directories
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
TRAINING_DATA_DIR=./data/training

# AWS S3 (optional, for cloud storage)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=oneka-satellite-data

# ============================================================================
# Processing Configuration
# ============================================================================

# SNAP toolbox installation path
SNAP_INSTALL_DIR=/usr/local/snap

# Number of parallel workers for processing
NUM_WORKERS=4

# Maximum cloud cover for Sentinel-2 scenes (%)
MAX_CLOUD_COVER=20

# ============================================================================
# Backend API Integration
# ============================================================================

# ONEKA backend API endpoint
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=your_api_key_here

# ============================================================================
# Logging
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/satellite_processing.log

# ============================================================================
# Development Settings
# ============================================================================

# Debug mode
DEBUG=False

# Test mode (use small data subsets)
TEST_MODE=False
